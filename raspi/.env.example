# Tapo アカウント認証情報（Tapoアプリでログインしているメールアドレス・パスワード）
TAPO_EMAIL=your_tapo_account@example.com
TAPO_PASSWORD=your_tapo_password

# VPS側 API のベースURL（末尾スラッシュなし）
API_URL=https://example.com/tapo/api

# VPS側 API 認証キー。
# 英数字のみで生成すること（Apache の SetEnv 経由だと $ や ! 等の記号が
# 正しく渡らないことがあるため。housemonitor構築時の教訓）。
API_KEY=your_random_api_key_here

# デバイス一覧: device_key:ip:mac のカンマ区切り。
# mac は接続失敗時のLAN discoveryによるIP自動追従に使う（DHCPでIPが変わっても
# MACで機器を特定し直し、~/tapo/ip_cache.json のIPを更新する）。
# 旧形式の device_key:ip（mac無し）も引き続き使えるが、その場合はIP自動追従の対象外
# となり固定IP運用になる。
DEVICES=plug1:192.168.1.100:AA-BB-CC-00-00-01,plug2:192.168.1.101:AA-BB-CC-00-00-02,plug3:192.168.1.102:AA-BB-CC-00-00-03
